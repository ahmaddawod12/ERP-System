rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDataPath(userId, docId) {
      return /databases/$(database)/documents/users/$(userId)/data/$(docId);
    }

    function userProfilePath(userId) {
      return userDataPath(userId, "profile");
    }

    function userProfileExists(userId) {
      return exists(userProfilePath(userId));
    }

    function userProfile(userId) {
      return get(userProfilePath(userId)).data;
    }

    function currentProfileExists() {
      return signedIn() && userProfileExists(request.auth.uid);
    }

    function currentRole() {
      return currentProfileExists() ? userProfile(request.auth.uid).role : null;
    }

    function currentCompanyId() {
      return currentProfileExists() ? userProfile(request.auth.uid).companyId : null;
    }

    function currentAccountType() {
      return currentProfileExists() ? userProfile(request.auth.uid).accountType : null;
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true ||
        currentRole() == "Dev"
      );
    }

    function workerPath(companyId, userId) {
      return /databases/$(database)/documents/companies/$(companyId)/workers/$(userId);
    }

    function workerExists(companyId, userId) {
      return exists(workerPath(companyId, userId));
    }

    function workerRole(companyId, userId) {
      return workerExists(companyId, userId) ? get(workerPath(companyId, userId)).data.role : null;
    }

    function companyRole(companyId) {
      return signedIn() ? workerRole(companyId, request.auth.uid) : null;
    }

    function canReadCompanyUserData(userId) {
      return signedIn() &&
        currentCompanyId() != null &&
        isCompanyWorker(currentCompanyId()) &&
        workerExists(currentCompanyId(), userId);
    }

    function canManageWorkerUserData(userId) {
      return canReadCompanyUserData(userId) &&
        companyRole(currentCompanyId()) in ["Manager", "Dev", "manager", "dev"];
    }

    function validProfileRole(role) {
      return role in ["Manager", "Worker", "User", "Basic", "Dev", "manager", "worker", "user", "basic", "dev"];
    }

    function validAccountType(accountType) {
      return accountType in ["solo", "business", "Solo", "Business"];
    }

    function isSoloScope(companyId) {
      return currentProfileExists() &&
        currentAccountType() == "solo" &&
        request.auth.uid == companyId;
    }

    function isCompanyWorker(companyId) {
      return signedIn() && workerExists(companyId, request.auth.uid);
    }

    function isCompanyMember(companyId) {
      return signedIn() && (
        (currentCompanyId() == companyId && isCompanyWorker(companyId)) ||
        isSoloScope(companyId)
      );
    }

    function canReadCompany(companyId) {
      return isAdmin() || isCompanyMember(companyId);
    }

    function canManageCompany(companyId) {
      return isAdmin() || (
        isCompanyWorker(companyId) &&
        companyRole(companyId) in ["Manager", "Dev"]
      );
    }

    function canWriteCompanyClients(companyId) {
      return isAdmin() || (
        isCompanyWorker(companyId) &&
        companyRole(companyId) in ["Manager", "User", "Basic", "Dev"]
      );
    }

    function canReadCompanyJobs(companyId) {
      return isAdmin() || (
        isCompanyWorker(companyId) &&
        !(companyRole(companyId) in ["Basic"])
      );
    }

    function canMutateAssignedJob(companyId) {
      return isCompanyWorker(companyId) &&
        companyRole(companyId) in ["Worker", "User"] &&
        resource.data.workerId == request.auth.uid &&
        request.resource.data.workerId == resource.data.workerId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt"]);
    }

    function canDeleteAssignedCompletedJob(companyId) {
      return isCompanyWorker(companyId) &&
        companyRole(companyId) in ["Worker", "User"] &&
        resource.data.workerId == request.auth.uid &&
        resource.data.status == "completed";
    }

    function canWorkerConsumeInventory(companyId) {
      return isCompanyWorker(companyId) &&
        companyRole(companyId) == "Worker" &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["quantity", "updatedAt"]) &&
        request.resource.data.quantity is int &&
        resource.data.quantity is int &&
        request.resource.data.quantity >= 0 &&
        request.resource.data.quantity <= resource.data.quantity;
    }

    function canCreateCertification(companyId) {
      return isAdmin() || isSoloScope(companyId) || (
        isCompanyWorker(companyId) &&
        companyRole(companyId) in ["Manager", "Worker", "User", "Basic", "Dev"]
      );
    }

    function isCompanyBootstrapManagerWrite(companyId, workerId) {
      return signedIn() &&
        request.auth.uid == workerId &&
        request.resource.data.role in ["Manager", "Dev"] &&
        exists(/databases/$(database)/documents/companies/$(companyId)) &&
        get(/databases/$(database)/documents/companies/$(companyId)).data.createdBy == request.auth.uid;
    }

    match /users/{uid}/data/profile {
      allow read: if isAdmin() || (
        signedIn() &&
        (request.auth.uid == uid || canReadCompanyUserData(uid))
      );

      allow create: if signedIn() &&
        request.auth.uid == uid &&
        request.resource.data.uid == uid &&
        request.resource.data.email is string &&
        validProfileRole(request.resource.data.role) &&
        (
          !("accountType" in request.resource.data) ||
          validAccountType(request.resource.data.accountType)
        );

      allow update: if isAdmin() || (
        signedIn() &&
        request.auth.uid == uid &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.email == resource.data.email &&
        validProfileRole(request.resource.data.role) &&
        (
          !("accountType" in request.resource.data) ||
          validAccountType(request.resource.data.accountType)
        )
      );
    }

    match /users/{uid}/data/cache {
      allow read, write: if isAdmin() || (
        signedIn() &&
        (request.auth.uid == uid || canManageWorkerUserData(uid))
      );
    }

    match /users/{uid}/data/inventory {
      allow read, write: if isAdmin() || (
        signedIn() &&
        (request.auth.uid == uid || canManageWorkerUserData(uid))
      );
    }

    match /users/{uid}/jobs/{jobId} {
      allow read, write: if isAdmin() || (
        signedIn() &&
        request.auth.uid == uid &&
        currentRole() != "Basic"
      );
    }

    match /users/{uid}/personal_inventory/{itemId} {
      allow read, write: if isAdmin() || (
        signedIn() &&
        request.auth.uid == uid &&
        currentRole() != "Basic"
      );
    }

    match /users/{uid}/clients/{clientId} {
      allow read, write: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }

    match /companies/{companyId} {
      allow read: if canReadCompany(companyId);
      allow create: if isAdmin() || (
        signedIn() &&
        request.resource.data.createdBy == request.auth.uid
      );
      allow update, delete: if canManageCompany(companyId);
    }

    match /companies/{companyId}/business_data/business_info {
      allow read: if canReadCompany(companyId);
      allow write: if canManageCompany(companyId);
    }

    match /companies/{companyId}/business_data/subscription {
      allow read: if canReadCompany(companyId);
      allow create, update: if isAdmin() || canManageCompany(companyId) || isSoloScope(companyId);
    }

    match /companies/{companyId}/business_data/inventory/parts/{partId} {
      allow read: if canReadCompany(companyId);
      allow create, delete: if canManageCompany(companyId);
      allow update: if canManageCompany(companyId) || canWorkerConsumeInventory(companyId);
    }

    match /companies/{companyId}/workers/{workerId} {
      allow read: if canReadCompany(companyId);
      allow create: if canManageCompany(companyId) || isCompanyBootstrapManagerWrite(companyId, workerId);
      allow update, delete: if canManageCompany(companyId);
    }

    match /companies/{companyId}/clients/{clientId} {
      allow read: if canReadCompany(companyId);
      allow write: if canWriteCompanyClients(companyId);
    }

    match /companies/{companyId}/counters/{counterId} {
      allow read: if canReadCompany(companyId);
      allow write: if canManageCompany(companyId);
    }

    match /companies/{companyId}/client_create_requests/{requestId} {
      allow read, write: if false;
    }

    match /companies/{companyId}/PendingJobs/{jobId} {
      allow read: if canReadCompanyJobs(companyId);
      allow create: if canManageCompany(companyId);
      allow update: if canManageCompany(companyId) || canMutateAssignedJob(companyId);
      allow delete: if canManageCompany(companyId) || canDeleteAssignedCompletedJob(companyId);
    }

    match /companies/{companyId}/finishedJobs/{jobId} {
      allow read: if canReadCompanyJobs(companyId);

      allow create: if canManageCompany(companyId) || (
        isCompanyWorker(companyId) &&
        companyRole(companyId) in ["Worker", "User"] &&
        request.resource.data.workerId == request.auth.uid
      );

      allow update: if canManageCompany(companyId) || (
        isCompanyWorker(companyId) &&
        companyRole(companyId) in ["Worker", "User"] &&
        resource.data.workerId == request.auth.uid &&
        request.resource.data.workerId == resource.data.workerId
      );

      allow delete: if canManageCompany(companyId);
    }

    match /companies/{companyId}/certifications/{id} {
      allow read: if canReadCompany(companyId);
      allow create: if canCreateCertification(companyId);
      allow update, delete: if canManageCompany(companyId);
    }

    match /companies/{companyId}/invites/{inviteId} {
      allow read, create, update, delete: if canManageCompany(companyId);
    }

    match /companies/{companyId}/inventory_picks/{pickId} {
      allow read: if canReadCompany(companyId);
      allow create: if canManageCompany(companyId) || (
        isCompanyWorker(companyId) &&
        companyRole(companyId) in ["Worker", "User"] &&
        request.resource.data.workerId == request.auth.uid
      );
      allow update, delete: if canManageCompany(companyId);
    }

    match /upgrade_requests/{requestId} {
      allow create: if signedIn() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.requestedTier in ["Solo", "Team", "Enterprise"];
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /contact_requests/{requestId} {
      allow read, update, delete: if isAdmin();
      allow create: if false;
    }
  }
}
