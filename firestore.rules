rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Utility functions ──────────────────────────────────────────────

    function signedIn() {
      return request.auth != null;
    }

    function userDataPath(userId, docId) {
      return /databases/$(database)/documents/users/$(userId)/data/$(docId);
    }

    function userProfilePath(userId) {
      return userDataPath(userId, "profile");
    }

    function userProfileExists(userId) {
      return exists(userProfilePath(userId));
    }

    function userProfile(userId) {
      return get(userProfilePath(userId)).data;
    }

    function currentProfileExists() {
      return signedIn() && userProfileExists(request.auth.uid);
    }

    function currentRole() {
      return currentProfileExists() ? userProfile(request.auth.uid).role : null;
    }

    function currentCompanyId() {
      return currentProfileExists() ? userProfile(request.auth.uid).companyId : null;
    }

    function currentAccountType() {
      return currentProfileExists() ? userProfile(request.auth.uid).accountType : null;
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true ||
        currentRole() == "dev"
      );
    }

    function workerPath(companyId, userId) {
      return /databases/$(database)/documents/companies/$(companyId)/workers/$(userId);
    }

    function workerExists(companyId, userId) {
      return exists(workerPath(companyId, userId));
    }

    function workerRole(companyId, userId) {
      return workerExists(companyId, userId) ? get(workerPath(companyId, userId)).data.role : null;
    }

    function companyRole(companyId) {
      return signedIn() ? workerRole(companyId, request.auth.uid) : null;
    }

    function isSoloScope(companyId) {
      return currentProfileExists() &&
        currentAccountType() == "solo" &&
        request.auth.uid == companyId;
    }

    function isCompanyWorker(companyId) {
      return signedIn() && workerExists(companyId, request.auth.uid);
    }

    function isCompanyMember(companyId) {
      return signedIn() && (
        (currentCompanyId() == companyId && isCompanyWorker(companyId)) ||
        isSoloScope(companyId)
      );
    }

    function canReadCompany(companyId) {
      return isAdmin() || isCompanyMember(companyId);
    }

    function canManageCompany(companyId) {
      return isAdmin() || (
        isCompanyWorker(companyId) &&
        companyRole(companyId) in ["manager", "dev"]
      );
    }

    // Manager/User/Basic can read company data (shared role set)
    function isManagerUserBasic(companyId) {
      return isCompanyWorker(companyId) &&
        companyRole(companyId) in ["manager", "user", "basic", "dev"];
    }

    // Check if caller is a manager in their own company and the target user is in the same company
    function canManagerAccessWorkerData(userId) {
      return signedIn() &&
        currentCompanyId() != null &&
        isCompanyWorker(currentCompanyId()) &&
        companyRole(currentCompanyId()) in ["manager", "dev"] &&
        workerExists(currentCompanyId(), userId);
    }

    // ── Profile: READ-ONLY from client. Updates via Cloud Function only ──
    // Each user can read their own profile.
    // Manager can read profiles of workers in the same company.
    // No client create/update/delete — handled by Cloud Functions.
    match /users/{uid}/data/profile {
      allow read: if isAdmin() || (
        signedIn() && request.auth.uid == uid
      ) || canManagerAccessWorkerData(uid);

      // Profile create/update/delete are ALL handled by Cloud Functions
      // (registerBusinessV1, updateProfileV1, manageWorker, joinCompanyV1)
      allow create, update, delete: if false;
    }

    // ── User Cache: owner can read/write, manager can write worker cache ──
    match /users/{uid}/data/cache {
      allow read, write: if isAdmin() || (
        signedIn() && request.auth.uid == uid
      );
      // Manager can write to worker's cache (same company)
      allow write: if canManagerAccessWorkerData(uid);
    }

    // ── User Inventory: owner can read/write/update/delete ──
    // Manager can read/write worker inventory (same company)
    match /users/{uid}/data/inventory {
      allow read, write: if isAdmin() || (
        signedIn() && request.auth.uid == uid
      ) || canManagerAccessWorkerData(uid);
    }

    // Legacy paths — keep existing access
    match /users/{uid}/jobs/{jobId} {
      allow read, write: if isAdmin() || (
        signedIn() &&
        request.auth.uid == uid &&
        currentRole() != "basic"
      );
    }

    match /users/{uid}/personal_inventory/{itemId} {
      allow read, write: if isAdmin() || (
        signedIn() &&
        request.auth.uid == uid &&
        currentRole() != "basic"
      );
    }

    match /users/{uid}/clients/{clientId} {
      allow read, write: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }

    // ── Company root document (cid, wid, jid fields) ──
    // Manager/User/Basic can read and update (for counter increments).
    // Create only by the company creator. No delete from client.
    match /companies/{companyId} {
      allow read: if canReadCompany(companyId);
      allow create: if isAdmin() || (
        signedIn() &&
        request.resource.data.createdBy == request.auth.uid
      );
      allow update: if isAdmin() || isManagerUserBasic(companyId);
      allow delete: if false;
    }

    // ── Business Info: READ-ONLY from client ──
    // Basic/User/Manager can read. Updates via Cloud Function only.
    // Cannot delete or write from client.
    match /companies/{companyId}/business_data/business_info {
      allow read: if canReadCompany(companyId);
      allow create: if isAdmin() || canManageCompany(companyId) || isSoloScope(companyId);
      allow update, delete: if false;
    }

    // ── Subscription: READ-ONLY from client ──
    // All company members can read. Write/update/delete via Cloud Function only.
    match /companies/{companyId}/business_data/subscription {
      allow read: if canReadCompany(companyId);
      allow create: if isAdmin() || canManageCompany(companyId) || isSoloScope(companyId);
      allow update, delete: if false;
    }

    // ── Company Inventory (single doc with parts array) ──
    // Worker + Manager can read. Manager can write/update/delete.
    match /companies/{companyId}/business_data/inventory {
      allow read: if canReadCompany(companyId);
      allow write: if canManageCompany(companyId);
    }

    // ── Company Cache: Manager can read/write/update/delete ──
    match /companies/{companyId}/business_data/cache {
      allow read, write: if canManageCompany(companyId);
      // Workers and users can read company cache (for cache invalidation)
      allow read: if canReadCompany(companyId);
    }

    // ── Token: NO client access ──
    // Tax Authority OAuth tokens — Cloud Functions only via Admin SDK.
    match /companies/{companyId}/business_data/token {
      allow read, write: if false;
    }

    // ── Workers ──
    match /companies/{companyId}/workers/{workerId} {
      allow read: if canReadCompany(companyId);
      // create/update/delete handled by Cloud Functions (manageWorker, joinCompanyV1)
      allow create, update, delete: if isAdmin();
    }

    // ── Clients ──
    // Manager/User/Basic can read and update.
    // Create and delete via Cloud Functions only (addClientV1, deleteClientV1).
    match /companies/{companyId}/clients/{clientId} {
      allow read: if isAdmin() || isManagerUserBasic(companyId);
      allow update: if isAdmin() || isManagerUserBasic(companyId);
      allow create, delete: if false;
    }

    // ── Counters (client counter, etc.) ──
    match /companies/{companyId}/counters/{counterId} {
      allow read: if canReadCompany(companyId);
      allow write: if false;
    }

    match /companies/{companyId}/client_create_requests/{requestId} {
      allow read, write: if false;
    }

    // ── Pending Jobs ──
    // User role does NOT have pending jobs.
    // Manager can read/write/update. Delete via Cloud Function only.
    // Worker can read + update ONLY jobs assigned to them, with field restrictions.
    match /companies/{companyId}/PendingJobs/{jobId} {
      allow read: if isAdmin() || canManageCompany(companyId) || (
        isCompanyWorker(companyId) &&
        (companyRole(companyId) == "worker") &&
        (resource.data.workerId == request.auth.uid || resource.data.completedBy == request.auth.uid)
      );

      allow create: if isAdmin() || canManageCompany(companyId);

      // S2: Worker updates are field-constrained — cannot change assignment, creator, or status
      allow update: if isAdmin() || canManageCompany(companyId) || (
        isCompanyWorker(companyId) &&
        companyRole(companyId) == "worker" &&
        resource.data.workerId == request.auth.uid &&
        // Pin immutable fields: assignment, creation, and approval metadata
        request.resource.data.workerId == resource.data.workerId &&
        request.resource.data.completedBy == resource.data.completedBy &&
        request.resource.data.createdBy == resource.data.createdBy &&
        // Workers cannot jump to 'finished' or 'denied' — must go through callable
        request.resource.data.status in ["pending", "received", "waiting"]
      );

      // Delete via Cloud Function only (deleteJobV1 / acceptJobV1)
      allow delete: if false;
    }

    // ── Finished Jobs ──
    // User and Manager can read/write/update their company finished jobs.
    // Worker can read ONLY jobs assigned to them.
    // Delete via Cloud Function only (deleteJobV1).
    match /companies/{companyId}/finishedJobs/{jobId} {
      allow read: if isAdmin() || canManageCompany(companyId) || (
        isCompanyWorker(companyId) &&
        companyRole(companyId) == "user"
      ) || (
        isCompanyWorker(companyId) &&
        companyRole(companyId) == "worker" &&
        resource.data.workerId == request.auth.uid
      );

      allow create: if isAdmin() || canManageCompany(companyId) || (
        isCompanyWorker(companyId) &&
        companyRole(companyId) == "user" &&
        request.resource.data.workerId == request.auth.uid
      );

      allow update: if isAdmin() || canManageCompany(companyId) || (
        isCompanyWorker(companyId) &&
        companyRole(companyId) == "user" &&
        resource.data.workerId == request.auth.uid &&
        request.resource.data.workerId == resource.data.workerId
      );

      // Delete via Cloud Function only (deleteJobV1)
      allow delete: if false;
    }

    // ── Certifications ──
    // Basic/User/Manager can READ. Write via Cloud Function (publishGenerateTask).
    // Manager can delete. No create or update from client.
    match /companies/{companyId}/certifications/{id} {
      allow read: if isAdmin() || isManagerUserBasic(companyId) || isSoloScope(companyId);
      allow delete: if isAdmin() || canManageCompany(companyId) || isSoloScope(companyId);
      allow create, update: if false;
    }

    // ── Invites ──
    match /companies/{companyId}/invites/{inviteId} {
      allow read, create, update, delete: if canManageCompany(companyId);
    }

    // ── Inventory Picks ──
    match /companies/{companyId}/inventory_picks/{pickId} {
      allow read: if canReadCompany(companyId);
      allow create: if canManageCompany(companyId) || (
        isCompanyWorker(companyId) &&
        companyRole(companyId) in ["worker", "user"] &&
        request.resource.data.workerId == request.auth.uid
      );
      allow update, delete: if canManageCompany(companyId);
    }

    // ── Document Tasks ──
    // Users can read their own tasks (for listening to task completion status).
    // Write is handled by Cloud Functions only.
    match /documentTasks/{taskId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create, update, delete: if false;
    }

    // ── Conversations (Support Chat) ──
    match /conversations/{conversationId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isAdmin() || (
          signedIn() &&
          get(/databases/$(database)/documents/conversations/$(conversationId)).data.userId == request.auth.uid
        );
        allow create: if isAdmin() || (
          signedIn() &&
          get(/databases/$(database)/documents/conversations/$(conversationId)).data.userId == request.auth.uid
        );
        allow update, delete: if isAdmin();
      }
    }

    // ── Upgrade Requests ──
    match /upgrade_requests/{requestId} {
      allow create: if signedIn() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.requestedTier in ["Solo", "Team", "Enterprise"];
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // ── Contact Requests ──
    match /contact_requests/{requestId} {
      allow read, update, delete: if isAdmin();
      allow create: if false;
    }

    // ── Admin-only paths (Cloud Functions via Admin SDK) ──
    match /companies/{companyId}/auditLogs/{logId} {
      allow read, write: if false;
    }

    match /notificationLog/{logId} {
      allow read, write: if false;
    }

    match /taxAuthPending/{authId} {
      allow read, write: if false;
    }

    match /taxAuthCallbacks/{authId} {
      allow read, write: if false;
    }
  }
}
