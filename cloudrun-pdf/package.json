{
  "name": "smartjob-pdf-service",
  "version": "1.2.0",
  "description": "Cloud Run service for PDF generation, preview with Puppeteer, and email delivery via AWS SES",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "npm run build && node dist/index.js",
    "dev": "npm run build && node dist/index.js",
    "test": "npm run build && node --test dist/tests/*.test.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.1030.0",
    "@smart-job/contracts": "file:../packages/contracts",
    "@supabase/supabase-js": "2.110.3",
    "express": "^4.18.2",
    "google-auth-library": "^9.15.0",
    "pg": "^8.16.3",
    "puppeteer": "24.40.0",
    "sanitize-html": "^2.11.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "@aws-sdk/xml-builder": {
      "fast-xml-parser": "5.5.12"
    },
    "basic-ftp": "5.2.2",
    "node-forge": "1.4.0",
    "path-to-regexp": "0.1.13",
    "qs": "6.15.1"
  }
}
