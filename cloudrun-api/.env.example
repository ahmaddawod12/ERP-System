NODE_ENV=development
DATABASE_URL=postgresql://smart_job_api:local-only@127.0.0.1:55322/postgres
DATABASE_SSL_MODE=disable
DATABASE_MAX_CONNECTIONS=5
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=smart-job-company-files
SUPABASE_JWT_ISSUER=http://127.0.0.1:55321/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
WEB_SESSION_ENCRYPTION_KEY_BASE64=
WEB_SESSION_ENCRYPTION_KEY_VERSION=local-v1
TAX_SUBMISSION_MODE=disabled

# Pub/Sub is optional only outside production. Compose injects its verified adapter values.
DOCUMENT_PUBSUB_PROJECT_ID=
DOCUMENT_PREVIEW_TOPIC=
DOCUMENT_GENERATE_TOPIC=
EMAIL_DELIVERY_TOPIC=
