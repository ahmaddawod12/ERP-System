{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "node16",
    "allowJs": true,
    "checkJs": false,
    "outDir": "dist",
    "rootDir": ".",
    "strict": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "index.ts",
    "archive-runner.ts",
    "archive-files.ts",
    "archive-month.ts",
    "local-platform.ts",
    "upload-cleanup.ts",
    "tests/**/*.js"
  ],
  "exclude": ["dist"]
}
