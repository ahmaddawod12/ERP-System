rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Maximum upload size: 100 MB
    function maxUploadSize() {
      return 100 * 1024 * 1024;
    }

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to get the authenticated user's identifier (Firebase UID)
    function getUid() {
      return request.auth.uid;
    }

    // Canonical profile path: users/{uid}/data/profile
    function profilePath(uid) {
      return /databases/(default)/documents/users/$(uid)/data/profile;
    }

    function profileExists(uid) {
      return firestore.exists(profilePath(uid));
    }

    function getProfile(uid) {
      return firestore.get(profilePath(uid)).data;
    }

    function getProfileWid(uid) {
      return profileExists(uid) && ('wid' in getProfile(uid)) ? getProfile(uid).wid : null;
    }

    function getProfileMid(uid) {
      return profileExists(uid) && ('mid' in getProfile(uid)) ? getProfile(uid).mid : null;
    }

    // Helper: check write size before upload
    function isValidUploadSize() {
      return request.resource == null || request.resource.size <= maxUploadSize();
    }
    
    // Helper function to check if user is a manager with access to worker's data
    function isManagerOfWorker(workerId) {
      return isAuthenticated() && 
             profileExists(getUid()) &&
             getProfile(getUid()).role in ['manager', 'dev'] &&
             profileExists(workerId) &&
             'companyId' in getProfile(getUid()) &&
             'companyId' in getProfile(workerId) &&
             getProfile(getUid()).companyId == getProfile(workerId).companyId;
    }
    
    // Helper function to check if user is a standard user (not manager or worker)
    function isUser() {
      return isAuthenticated() && 
             profileExists(getUid()) &&
             getProfile(getUid()).role == 'user';
    }
    
    // Helper function to check if user is a manager
    function isManager() {
      return isAuthenticated() && 
             profileExists(getUid()) &&
             getProfile(getUid()).role in ['manager', 'dev'];
    }
    
    // Simplified company membership check: uses profile companyId to avoid
    // redundant Firestore reads. The profile.companyId is set by trusted
    // Cloud Functions (registerBusinessV1 / joinCompanyV1) and cannot be
    // tampered with by clients.
    function isCompanyMember(companyId) {
      return isAuthenticated() &&
             profileExists(getUid()) &&
             'companyId' in getProfile(getUid()) &&
             getProfile(getUid()).companyId == companyId;
    }

    // Helper function to check if user belongs to company scope
    function ownsCompany(companyId) {
      return isCompanyMember(companyId);
    }
    
    // user job photos and signatures
    // Path: {uid}/jobs/{jobId}/{filename}
    match /{uid}/jobs/{jobId}/{filename} {
      // users can read/write/delete their own job files
      allow read, delete: if isAuthenticated() && getUid() == uid;
      allow write: if isAuthenticated() && getUid() == uid && isValidUploadSize();
      
      // managers can read/write/delete files of workers in their company
      allow read, delete: if isManagerOfWorker(uid);
      allow write: if isManagerOfWorker(uid) && isValidUploadSize();
    }
    
    // Inventory or other user files
    // Path: {uid}/inventory/{filename}
    match /{uid}/inventory/{filename} {
      // users can read/write/delete their own inventory files
      allow read, delete: if isAuthenticated() && getUid() == uid;
      allow write: if isAuthenticated() && getUid() == uid && isValidUploadSize();
      
      // managers can read/write/delete inventory files of workers in their company
      allow read, delete: if isManagerOfWorker(uid);
      allow write: if isManagerOfWorker(uid) && isValidUploadSize();
    }
    
    // Company-level storage for documents (PDFs, invoices, etc.)
    // Path: companies/{companyId}/documents/{filename}
    match /companies/{companyId}/documents/{filename} {
      allow read, delete: if ownsCompany(companyId) && (isManager() || isUser());
      allow write: if ownsCompany(companyId) && (isManager() || isUser()) && isValidUploadSize();
    }
    
    // Company-level storage for job-related files
    // Path: companies/{companyId}/jobs/{jobId}/{filename}
    match /companies/{companyId}/jobs/{jobId}/{filename} {
      // managers can manage all company job files
      allow read, delete: if ownsCompany(companyId) && isManager();
      allow write: if ownsCompany(companyId) && isManager() && isValidUploadSize();
      // users can manage files for jobs they created
      allow read, delete: if ownsCompany(companyId) && isUser();
      allow write: if ownsCompany(companyId) && isUser() && isValidUploadSize();
    }
    
    // Archived data (finishedJobs & documents moved from Firestore to Storage)
    // Path: companies/{companyId}/archives/{archiveFile}
    // Written by Cloud Run Job (Admin SDK, bypasses rules), read by mobile app
    match /companies/{companyId}/archives/{archiveFile} {
      // Any authenticated user who belongs to this company can read archives
      allow read: if ownsCompany(companyId);
    }
  }
}
