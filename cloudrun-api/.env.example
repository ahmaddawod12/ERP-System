NODE_ENV=development
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
REQUEST_TIMEOUT_MS=12000
DATABASE_URL=postgresql://smart_job_api:local-only@127.0.0.1:55432/postgres
DATABASE_SSL_MODE=disable
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_SSL_CA=
DATABASE_MAX_CONNECTIONS=5
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECT_TIMEOUT_MS=10000
FIREBASE_PROJECT_ID=smart-job-local
FIREBASE_WEB_API_KEY=replace-with-firebase-web-api-key
GCS_PROJECT_ID=smart-job-local
COMPANY_FILES_BUCKET=smart-job-company-files
WEB_SESSION_ENCRYPTION_KEY_BASE64=replace-with-canonical-base64-for-exactly-32-bytes
WEB_SESSION_ENCRYPTION_KEY_VERSION=local-v1
TAX_SUBMISSION_MODE=disabled
TAX_GATEWAY_URL=
TAX_GATEWAY_AUDIENCE=
TAX_GATEWAY_TIMEOUT_MS=8000

# Required together for Google-identity-protected internal routes.
INTERNAL_API_AUDIENCE=
INTERNAL_CALLER_SERVICE_ACCOUNTS=

# Required together in production. Local Compose injects verified adapter values.
DOCUMENT_PUBSUB_PROJECT_ID=
DOCUMENT_PREVIEW_TOPIC=
DOCUMENT_GENERATE_TOPIC=
EMAIL_DELIVERY_TOPIC=
ARCHIVE_BUCKET=

# FIREBASE_AUTH_EMULATOR_HOST, GCS_API_ENDPOINT,
# COMPANY_FILES_PUBLIC_BASE_URL, PUBSUB_API_BASE_URL,
# GOOGLE_METADATA_ACCESS_TOKEN_URL, LOCAL_INTERNAL_IDENTITY_TOKEN, and all
# SMART_JOB_LOCAL_PLATFORM flags are lifecycle-script-only. Never set them by hand.
