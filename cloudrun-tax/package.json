{
  "name": "@smart-job/cloudrun-tax",
  "version": "0.1.0",
  "private": true,
  "description": "Stateless Cloud Run gateway for Israeli tax-authority traffic",
  "type": "module",
  "main": "dist/src/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --import @smart-job/observability/register dist/src/server.js",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "test:coverage": "npm run build && node --test --experimental-test-coverage --test-coverage-include=dist/**/*.js --test-coverage-exclude=dist/tests/** --test-coverage-lines=85.08 --test-coverage-branches=82.68 --test-coverage-functions=87.76 dist/tests/*.test.js"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@smart-job/api-contracts": "file:../packages/api-contracts",
    "@smart-job/contracts": "file:../packages/contracts",
    "@smart-job/observability": "file:../packages/observability",
    "fastify": "5.10.0",
    "jose": "6.2.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "5.9.3"
  },
  "overrides": {
    "find-my-way": "9.7.0"
  }
}
