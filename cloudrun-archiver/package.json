{
  "name": "job-archiver",
  "version": "1.0.0",
  "description": "Cloud Run Job for archiving old Firestore data to Cloud Storage (finished jobs & documents)",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "npm run build && node dist/index.js",
    "test": "npm run build && node --test dist/tests/*.test.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@smart-job/db": "file:../packages/db",
    "@google-cloud/storage": "^7.19.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "@google-cloud/storage": {
      "fast-xml-parser": "5.5.12"
    },
    "node-forge": "1.4.0"
  }
}
