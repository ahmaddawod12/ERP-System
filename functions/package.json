{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "test": "npm run build && npm run check:syntax && npm run test:unit && npm run test:rules && npm run test:storage",
    "check:syntax": "node ../scripts/check-js-syntax.mjs src tests ../cloudrun-pdf ../cloudrun-archiver",
    "test:unit": "node --test dist/tests/*.test.js",
    "test:rules": "firebase emulators:exec --project demo-smart-job --only firestore \"node --test dist/tests/firestore-rules.rules.js\"",
    "test:storage": "firebase emulators:exec --project demo-smart-job --only firestore,storage \"node --test dist/tests/storage-rules.rules.js\"",
    "deploy": "npm run build && firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "dist/index.js",
  "dependencies": {
    "@smart-job/db": "file:../packages/db",
    "@smart-job/contracts": "file:../packages/contracts",
    "@google-cloud/pubsub": "^4.11.0",
    "axios": "^1.15.0",
    "axios-retry": "^4.5.0",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.0.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.10.0",
    "firebase-functions-test": "^3.4.1",
    "firebase-tools": "^15.14.0",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "anymatch": {
      "picomatch": "2.3.2"
    },
    "brace-expansion": "2.0.3",
    "fast-xml-parser": "4.5.5",
    "glob": {
      "minimatch": "9.0.7"
    },
    "jest-util": {
      "picomatch": "4.0.4"
    },
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.13"
    },
    "minimatch@9.0.7": {
      "brace-expansion": "2.0.3"
    },
    "node-forge": "1.4.0",
    "path-to-regexp": "0.1.13",
    "qs": "6.15.1",
    "readdirp": {
      "picomatch": "2.3.2"
    },
    "test-exclude": {
      "minimatch": "3.1.5"
    }
  },
  "private": true
}
