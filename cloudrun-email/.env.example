NODE_ENV=development
DATABASE_URL=postgresql://smart_job_email:local-only@127.0.0.1:55322/postgres
DATABASE_SSL_MODE=disable
DATABASE_MAX_CONNECTIONS=3

# Production uses Cloud Run OIDC. The shared token is a local-only fallback.
CLOUD_RUN_SERVICE_URL=
PUBSUB_ALLOWED_SERVICE_ACCOUNTS=
PUBSUB_VERIFICATION_TOKEN=
GCS_PROJECT_ID=smart-job-local
COMPANY_FILES_BUCKET=smart-job-company-files
SIGNED_DOWNLOAD_TTL_SECONDS=86400
AWS_REGION=eu-central-1
AWS_SES_CREDENTIAL_MODE=static
# Production may inject this complete pair from Secret Manager. Omit both when
# the runtime uses an AWS credential provider such as workload federation.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Post-stabilization federation mode forbids the static pair above and requires:
# AWS_SES_CREDENTIAL_MODE=federated
# AWS_SES_ROLE_ARN=arn:aws:iam::123456789012:role/smart-job-email-ses
# AWS_SES_OIDC_AUDIENCE=smart-job-email-production
# AWS_GOOGLE_SERVICE_ACCOUNT_UNIQUE_ID=123456789012345678901
SES_FROM_EMAIL=documents@example.test
SES_FROM_NAME=Smart-Job
EMAIL_SEND_LEASE_SECONDS=60
PORT=8080

# GCS_API_ENDPOINT, COMPANY_FILES_PUBLIC_BASE_URL, and AWS_SES_ENDPOINT are
# verified-local-platform-only and
# are injected by the lifecycle script together with fake local AWS credentials.
# Never put real AWS credentials in this file.
