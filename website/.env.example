# Copy to .env.local. Never commit real credentials.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_AUTH_TIMEOUT_MS=8000

# Server-only Cloud Run API origin and bounded request deadline.
BACKEND_API_BASE_URL=https://api.example.com
BACKEND_API_TIMEOUT_MS=12000

# Exact public origin. WEBSITE_SESSION_SECRET must contain at least 32 random characters.
WEBSITE_ORIGIN=https://app.example.com
WEBSITE_SESSION_SECRET=replace-with-at-least-32-random-characters
CONTACT_CHALLENGE_SECRET=replace-with-a-distinct-32-character-secret

# Contact-form reCAPTCHA Enterprise configuration.
RECAPTCHA_ENTERPRISE_PROJECT_ID=replace-with-gcp-project-id
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=replace-with-public-site-key
RECAPTCHA_ENTERPRISE_MIN_SCORE=0.7
RECAPTCHA_ENTERPRISE_TIMEOUT_MS=8000
