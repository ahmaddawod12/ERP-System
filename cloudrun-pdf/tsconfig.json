{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "node16",
    "allowJs": true,
    "checkJs": false,
    "outDir": "dist",
    "rootDir": ".",
    "strict": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "browser-pool.ts",
    "company-file-storage.ts",
    "document-payload.ts",
    "htmlTemplate.ts",
    "index.ts",
    "logging.ts",
    "logo-cache.ts",
    "page-security.ts",
    "persistence.ts",
    "pdf-storage-workflow.ts",
    "pubsub-auth.ts",
    "routes/**/*.ts",
    "sql-store.ts",
    "storage-paths.ts",
    "worker-store.ts",
    "tests/**/*.js",
    "types/**/*.d.ts"
  ],
  "exclude": ["dist"]
}
