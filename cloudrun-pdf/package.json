{
  "name": "smartjob-pdf-service",
  "version": "1.2.0",
  "description": "Cloud Run worker for canonical PDF generation and preview tasks",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "npm run build && node --import @smart-job/observability/register dist/index.js",
    "dev": "npm run build && node --import @smart-job/observability/register dist/index.js",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "test:coverage": "npm run build && node --test --experimental-test-coverage --test-coverage-include=dist/**/*.js --test-coverage-exclude=dist/tests/** --test-coverage-lines=78.56 --test-coverage-branches=60.34 --test-coverage-functions=80.77 dist/tests/*.test.js"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@smart-job/api-contracts": "file:../packages/api-contracts",
    "@smart-job/contracts": "file:../packages/contracts",
    "@smart-job/observability": "file:../packages/observability",
    "@supabase/supabase-js": "2.110.3",
    "express": "^4.22.2",
    "google-auth-library": "10.9.0",
    "pg": "^8.16.3",
    "puppeteer": "24.40.0",
    "sanitize-html": "^2.11.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.23",
    "@types/node": "22.20.1",
    "@types/sanitize-html": "^2.16.1",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "basic-ftp": "5.3.1",
    "node-forge": "1.4.0",
    "path-to-regexp": "0.1.13",
    "qs": "6.15.3"
  }
}
