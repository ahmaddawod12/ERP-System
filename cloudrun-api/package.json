{
  "name": "@smart-job/cloudrun-api",
  "version": "0.1.0",
  "private": true,
  "description": "Smart-Job ERP modular Cloud Run API",
  "type": "module",
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "exports": {
    "./app": {
      "types": "./dist/app.d.ts",
      "default": "./dist/app.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "test": "npm run build && node --test dist/tests/*.test.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@fastify/swagger": "9.8.0",
    "@smart-job/api-contracts": "file:../packages/api-contracts",
    "@smart-job/contracts": "file:../packages/contracts",
    "@smart-job/db": "file:../packages/db",
    "@supabase/supabase-js": "2.110.3",
    "fastify": "5.10.0",
    "fastify-type-provider-zod": "7.0.0",
    "jose": "6.2.3",
    "pg": "8.20.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/pg": "8.20.0",
    "typescript": "5.9.3"
  },
  "license": "UNLICENSED"
}
