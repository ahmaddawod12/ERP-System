{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "allowJs": true,
    "checkJs": false,
    "outDir": "dist",
    "rootDir": ".",
    "strict": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "index.ts",
    "src/shared-http.ts",
    "src/shared-access.ts",
    "src/archive-access.ts",
    "src/auth.ts",
    "src/clients.ts",
    "src/documents.ts",
    "src/inventory.ts",
    "src/invite-membership.ts",
    "src/invites.ts",
    "src/job-mutation-resolver.ts",
    "src/jobs.ts",
    "src/misc.ts",
    "src/profile.ts",
    "src/read-model.ts",
    "src/shared.ts",
    "src/sql-access.ts",
    "src/sql-clients.ts",
    "src/sql-company-counters.ts",
    "src/sql-company-profile.ts",
    "src/sql-company-sync.ts",
    "src/sql-document-tasks.ts",
    "src/sql-documents.ts",
    "src/sql-inventory.ts",
    "src/sql-jobs.ts",
    "src/sql-membership.ts",
    "src/sql-provisioning.ts",
    "src/sql-tax-auth.ts",
    "src/sql-tax-bookkeeping.ts",
    "src/sql-user-profile.ts",
    "src/support.ts",
    "src/tax-invoice.ts",
    "src/tax-oauth.ts",
    "src/tax.ts",
    "tests/**/*.js",
    "types/**/*.d.ts"
  ],
  "exclude": ["dist"]
}