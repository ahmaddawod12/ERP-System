{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "allowJs": true,
    "checkJs": false,
    "outDir": "dist",
    "rootDir": ".",
    "strict": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "access-store.ts",
    "company-sync-store.ts",
    "document-payload.ts",
    "document-store.ts",
    "emailService.ts",
    "htmlTemplate.ts",
    "index.ts",
    "persistence.ts",
    "task-store.ts",
    "tests/**/*.js",
    "types/**/*.d.ts"
  ],
  "exclude": ["dist"]
}