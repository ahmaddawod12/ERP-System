NODE_ENV=development
SMART_JOB_PERSISTENCE_BACKEND=sql
DATABASE_URL=postgresql://smart_job_pdf:local-only@127.0.0.1:55322/postgres
DATABASE_SSL_MODE=disable
DATABASE_SSL_CA=
DATABASE_MAX_CONNECTIONS=3
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_SECRET_KEY=sb_secret_replace_me
SUPABASE_STORAGE_BUCKET=smart-job-company-files

# Production uses Cloud Run OIDC. The shared token is a local-only fallback.
CLOUD_RUN_SERVICE_URL=
PUBSUB_ALLOWED_SERVICE_ACCOUNTS=
PUBSUB_VERIFICATION_TOKEN=

DOCUMENT_TASK_PROCESSING_LEASE_SECONDS=300
MAX_CONCURRENT_TABS=2
MAX_TAB_WAITERS=64
TAB_WAIT_TIMEOUT_MS=10000
JSON_BODY_LIMIT=1mb
PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable
SHUTDOWN_TIMEOUT_MS=30000
PORT=8080
